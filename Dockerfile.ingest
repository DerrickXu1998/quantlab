# syntax=docker/dockerfile:1
#
# Ingest image: the research library (providers, fx normalisation, store).
#
# This is deliberately a different image from ./backend. The backend serves
# read queries and must not carry the provider stack or network credentials;
# ingest reaches the outside world and must not be in the request path.
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    QUANTLAB_HOME=/var/lib/quantlab

WORKDIR /app

COPY pyproject.toml README.md ./
COPY src ./src
COPY tests ./tests

# yahoo is the documented fallback and the only free source of UK corporate
# actions, so the ingest image carries it even though stooq is primary.
# streaming adds kafka-python for `quantlab replay-publish`.
# dev extras come along so the same image can run the store test suite
# against the live stack (`make store-test`).
RUN pip install --no-cache-dir ".[store,yahoo,streaming,dev]"

# HTTP cache and Parquet exports live here. Mount a volume to keep the cache
# across runs -- historical files are fetched with ttl=-1 and never change,
# so a warm cache turns a re-ingest into a no-network operation.
VOLUME ["/var/lib/quantlab"]

ENTRYPOINT ["quantlab"]
CMD ["coverage"]
