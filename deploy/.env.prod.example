# QuantLab production environment -- the template for /opt/quantlab/.env on the VM.
#
# `deploy/bootstrap-vm.sh` generates the real file once, with random database
# passwords, and never touches it again. It is not in git and must not be: it
# holds the only copy of those passwords and your API keys.
#
# Image tags do NOT live here. The deploy workflow writes them to a second file,
# /opt/quantlab/.env.images, and Compose reads both:
#
#     docker compose --env-file .env --env-file .env.images -f docker-compose.prod.yml up -d
#
# That split is the point: CI rewrites image tags on every deploy and never has
# to read, template or round-trip your secrets to do it.

# --- Public address -----------------------------------------------------------
# This VM serves the API only; the SPA is on Vercel.
#
# A hostname here makes Caddy provision a Let's Encrypt certificate on first
# request. Unlike a same-origin deployment, that is not optional: Vercel serves
# the SPA over HTTPS and browsers refuse to let an HTTPS page call an HTTP API.
# A bare IP cannot be used either -- no CA issues certificates for one.
#
# Keep :80 only while bringing the stack up and curling it from the VM itself.
# Set the hostname once DNS resolves to this VM: ACME failures are rate-limited,
# so pointing Caddy at a name that does not resolve here will burn through them.
QUANTLAB_SITE_ADDRESS=:80
# QUANTLAB_SITE_ADDRESS=api.example.com
QUANTLAB_ACME_EMAIL=

# --- Datastore credentials ----------------------------------------------------
# Generated by bootstrap-vm.sh. Both databases are bound to 127.0.0.1, so these
# guard against a container escape and a misconfigured firewall, not the open
# internet -- which is exactly why they should still be random.
QUANTLAB_PG_USER=quantlab
QUANTLAB_PG_PASSWORD=CHANGE_ME
QUANTLAB_CH_USER=quantlab
QUANTLAB_CH_PASSWORD=CHANGE_ME

# Connection URLs the backend and ingest read. Hostnames are Compose service
# names. Keep the credentials in step with the four variables above -- Compose
# does not derive one from the other, so a password changed in only one place
# fails at connect time, not at start-up.
QUANTLAB_DB_URL=postgresql://quantlab:CHANGE_ME@postgres:5432/quantlab
QUANTLAB_CH_URL=clickhouse://quantlab:CHANGE_ME@clickhouse:8123/quantlab

# --- CORS ---------------------------------------------------------------------
# REQUIRED. The stack refuses to start without it, and empty counts as missing.
#
# The SPA is on Vercel and the API is here, so every browser call is
# cross-origin. Unset, the API answers curl perfectly and the actual app sees
# nothing but CORS errors -- a failure that is invisible from the server side,
# which is why it is worth refusing to start over.
#
# Comma-separated, exact origins, scheme included, no trailing slash, no
# wildcard (resolve_cors_origins() deliberately supports none). Note that Vercel
# gives every preview deployment its own URL, so previews will NOT be able to
# call this API unless you add each one -- use a stable production domain here.
QUANTLAB_CORS_ORIGINS=https://your-project.vercel.app

# --- Credentialed ingest jobs -------------------------------------------------
# All free to obtain; see docs/DATA_SOURCES.md. Empty means the corresponding
# job fails fast with a clear "set ..." message rather than half-running.
QUANTLAB_USER_AGENT=quantlab/0.1 (research)
SEC_USER_AGENT=
FRED_API_KEY=
COMPANIES_HOUSE_API_KEY=
