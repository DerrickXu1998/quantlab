# Copy to .env and fill in real values. .env is gitignored; .env.example is not.
# The CLI reads these from the environment, so `source .env` before running quantlab.

# Postgres catalog (local Docker Compose default shown)
QUANTLAB_DB_URL=postgresql://quantlab:quantlab@localhost:5432/quantlab

# ClickHouse bars store.
# Local Docker Compose:
#   QUANTLAB_CH_URL=clickhouse://quantlab:quantlab@localhost:8123/quantlab
# ClickHouse Cloud (note the clickhouses:// scheme -- that enables TLS):
QUANTLAB_CH_URL=clickhouse://quantlab:quantlab@localhost:8123/quantlab

# Credentialed ingest jobs (all free to obtain; compose injects them into the
# ingest container). Leave unset and the job fails fast with a clear message.
# SEC EDGAR: a User-Agent with your contact email. Used by `make map-sec-tickers`
# and `make ingest-sec-fundamentals`.
SEC_USER_AGENT=
# FRED: developer.stlouisfed.org -- `make ingest-fred`.
FRED_API_KEY=
# Companies House: developer.company-information.service.gov.uk --
# `make ingest-ch-fundamentals`.
COMPANIES_HOUSE_API_KEY=

# Live market data (roadmap 4a; `make live-up`). The IBKR login IB Gateway
# uses -- start with the paper account. Never commit real values.
IBKR_USERNAME=
IBKR_PASSWORD=
IBKR_TRADING_MODE=paper
# IBKR gives an account ~100 concurrent market-data lines; keep headroom.
QUANTLAB_LIVE_MAX_LINES=90
