# syntax=docker/dockerfile:1
#
# Migrate image: the warehouse schema and `quantlab migrate`, nothing else.
#
# Runs as the `migrate` step of every deploy, before the backend starts, and
# exits once Postgres and ClickHouse match the migrations in
# src/quantlab/store/. Data ingestion used to share this image; it moved to
# quantlab-data-pipeline, so this one carries two database drivers and no
# provider stack, credentials or network access beyond the two stores.
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

COPY pyproject.toml README.md ./
COPY src ./src
COPY tests ./tests

# dev brings pytest so `make store-test` can check the schema against the
# live stack from this same image.
RUN pip install --no-cache-dir ".[dev]"

ENTRYPOINT ["quantlab"]
CMD ["migrate"]
